{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [400, 429, 503, 529],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true,
  },
  "background_task": {
    "defaultConcurrency": 1,
    "staleTimeoutMs": 180000,
    "providerConcurrency": {
      "opencode-go": 2,
    },
    "modelConcurrency": {
      "opencode-go/grok-4.5": 1,
      "opencode-go/glm-5.2": 1,
      "opencode-go/glm-5.1": 1,
      "opencode-go/kimi-k3": 1,
      "opencode-go/kimi-k2.7-code": 1,
      "opencode-go/kimi-k2.6": 1,
      "opencode-go/mimo-v2.5": 5,
      "opencode-go/mimo-v2.5-pro": 2,
      "opencode-go/minimax-m3": 2,
      "opencode-go/minimax-m2.7": 2,
      "opencode-go/qwen3.7-max": 1,
      "opencode-go/qwen3.7-plus": 2,
      "opencode-go/qwen3.6-plus": 2,
      "opencode-go/deepseek-v4-pro": 2,
      "opencode-go/deepseek-v4-flash": 5,
      "opencode-go/hy3": 2,
    },
  },
  "agents": {
    "sisyphus": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": [
        "opencode-go/qwen3.7-plus",
        "opencode-go/glm-5.2",
        "opencode-go/qwen3.6-plus",
        "opencode-go/glm-5.1",
        "opencode-go/minimax-m3",
        "opencode-go/deepseek-v4-pro",
      ],
      "ultrawork": {
        "model": "opencode-go/kimi-k3",
      },
    },
    "prometheus": {
      "model": "opencode-go/glm-5.2",
      "fallback_models": ["opencode-go/qwen3.7-max", "opencode-go/qwen3.7-plus", "opencode-go/deepseek-v4-pro"],
      "prompt_append": "Always interview first. Validate scope before planning.",
    },
    "atlas": {
      "model": "opencode-go/deepseek-v4-pro",
      "fallback_models": ["opencode-go/minimax-m3", "opencode-go/deepseek-v4-flash"],
    },
    "metis": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": ["opencode-go/qwen3.6-plus", "opencode-go/deepseek-v4-pro"],
    },
    "momus": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": ["opencode-go/qwen3.6-plus", "opencode-go/kimi-k2.7-code"],
    },
    "hephaestus": {
      "model": "opencode-go/minimax-m3",
      "fallback_models": ["opencode-go/deepseek-v4-pro", "opencode-go/kimi-k2.7-code", "opencode-go/deepseek-v4-flash"],
      "prompt_append": "Explore thoroughly, then implement. Prefer small, testable changes.",
    },
    "oracle": {
      "model": "opencode-go/kimi-k3",
      "fallback_models": [
        "opencode-go/qwen3.7-max",
        "opencode-go/glm-5.2",
        "opencode-go/glm-5.1",
        "opencode-go/kimi-k2.7-code",
        "opencode-go/deepseek-v4-pro",
      ],
    },
    "librarian": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": ["opencode-go/mimo-v2.5", "opencode-go/qwen3.6-plus"],
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": ["opencode-go/qwen3.6-plus", "opencode-go/mimo-v2.5"],
    },
    "multimodal-looker": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": "opencode-go/qwen3.6-plus",
    },
    "sisyphus-junior": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": "opencode-go/mimo-v2.5",
    },
    "code-reviewer": {
      "model": "opencode-go/qwen3.7-max",
      "fallback_models": ["opencode-go/kimi-k2.7-code", "opencode-go/deepseek-v4-pro"],
    },
  },
  "categories": {
    "visual-engineering": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": "opencode-go/qwen3.6-plus",
    },
    "ultrabrain": {
      "model": "opencode-go/qwen3.7-max",
      "fallback_models": ["opencode-go/glm-5.2", "opencode-go/glm-5.1", "opencode-go/kimi-k2.7-code"],
    },
    "deep": {
      "model": "opencode-go/qwen3.7-max",
      "fallback_models": ["opencode-go/minimax-m3", "opencode-go/deepseek-v4-pro"],
    },
    "artistry": {
      "model": "opencode-go/glm-5.2",
      "fallback_models": ["opencode-go/qwen3.7-plus", "opencode-go/qwen3.6-plus"],
    },
    "quick": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": "opencode-go/mimo-v2.5",
    },
    "unspecified-low": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": "opencode-go/qwen3.7-plus",
    },
    "unspecified-high": {
      "model": "opencode-go/minimax-m3",
      "fallback_models": ["opencode-go/deepseek-v4-pro", "opencode-go/kimi-k2.7-code"],
    },
    "writing": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": "opencode-go/qwen3.6-plus",
    },
  },
  "git_master": {
    "include_co_authored_by": false,
  },
}
