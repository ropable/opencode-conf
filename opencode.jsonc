{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/bash",
  "plugins": ["opencode-supermemory@2.0.17", "cc-safety-net@2.7.0"],
  "agents": {
    "reviewer": {
      "description": "Review changes without editing files",
      "mode": "subagent",
      "system": "Focus on correctness, security, and missing tests.",
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }],
    },
  },
  "mcp": {
    "servers": {
      "supermemory-docs": {
        "type": "remote",
        "url": "https://supermemory.ai/docs/mcp",
      },
    },
  },
  "lsp": true,
  "compaction": {
    "keep": {
      "tokens": 15000,
    },
    "buffer": 20000,
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/*", "effect": "allow" },
  ],
  "providers": {
    "opencode-go": {
      "settings": {
        "baseURL": "http://127.0.0.1:17321",
      },
      "headers": {
        "sleev-provider": "opencode-go",
        "sleev-harness": "opencode",
      },
    },
    "opencode": {
      "settings": {
        "baseURL": "http://127.0.0.1:17321",
      },
      "headers": {
        "sleev-provider": "opencode",
        "sleev-harness": "opencode",
      },
    },
  },
}
