{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow",
  },
  "plugin": ["opencode-websearch-cited", "opencode-supermemory", "oh-my-openagent@latest"],
  "lsp": true,
  "compaction": {
    "prune": false
  },
  "provider": {
    "opencode": {
      "options": {
        "headers": {
          "sleev-provider": "opencode",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    },
    "opencode-go": {
      "options": {
        "headers": {
          "sleev-provider": "opencode-go",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    }
  },
}
