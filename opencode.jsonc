{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["opencode-supermemory@2.0.17", "cc-safety-net@2.7.0"],
  "lsp": true,
  "compaction": {
    "keep": {
      "tokens": 15000,
    },
    "buffer": 20000,
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
  ],
  "providers": {
    "opencode-go": {
      "settings": {
        "baseURL": "http://127.0.0.1:17321"
      },
      "headers": {
        "sleev-provider": "opencode-go",
        "sleev-harness": "opencode"
      }
    },
    "opencode": {
      "settings": {
        "baseURL": "http://127.0.0.1:17321"
      },
      "headers": {
        "sleev-provider": "opencode",
        "sleev-harness": "opencode"
      }
    }
  },
}
